// emit-c smoke (no ESP-IDF link required for Klin frontend).
import "../../esp_eth" eth

fn main() {
  let _h = eth.set_hostname("klin-eth")
  let ip = eth.ipv4(192, 168, 1, 50)
  let gw = eth.ipv4(192, 168, 1, 1)
  let mask = eth.ipv4(255, 255, 255, 0)
  let _s = eth.set_static_ip(ip, gw, mask)
  let _k = eth.phy_lan87xx()
  let _p = eth.phy_ip101()
  let _c = eth.clk_ext_in()
  let _o = eth.clk_out()
  let mut e = eth.w5500_start(eth.spi2_host(), 11, 13, 12, 14, 10, 9, 20, 10)
  if e != eth.err_ok() {
    return
  }
  e = eth.rmii_start(
    31, 52, 51, 1, eth.phy_ip101(),
    eth.clk_ext_in(), 50, -1,
    49, 34, 35, 28, 29, 30
  )
  if e != eth.err_ok() {
    return
  }
  eth.log_mac()
  e = eth.wait_link(1000)
  if e != eth.err_ok() {
    return
  }
  if !eth.link_up() {
    return
  }
  e = eth.wait_ip(1000)
  if e != eth.err_ok() {
    return
  }
  if eth.ip_u32() == 0 {
    return
  }
  if eth.gateway_u32() == 0 {
    return
  }
  if eth.netmask_u32() == 0 {
    return
  }
  eth.log_ip()
  eth.log_ip_info()
  let _v = eth.version()
}
