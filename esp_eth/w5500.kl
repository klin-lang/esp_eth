/// ESP-IDF Ethernet — W5500 SPI backend (thin Klin surface over `w5500_idf.c`).
/// One package for all ETH backends; RMII (ESP32/P4 EMAC) comes later.
/// Not part of `machine_esp`.
module esp_eth

@[link("w5500_idf.c")]
@[cinclude("w5500_idf.h")]
@[cimport, codename("klin_eth_set_static_ip")]
fn klin_eth_set_static_ip(ip: u32, gw: u32, netmask: u32): i32

@[cimport, codename("klin_eth_set_hostname")]
fn klin_eth_set_hostname(name: str): i32

@[cimport, codename("klin_eth_w5500_start")]
fn klin_eth_w5500_start(
    spi_host: i32,
    mosi: i32,
    miso: i32,
    sclk: i32,
    cs: i32,
    int_gpio: i32,
    rst_gpio: i32,
    clock_mhz: i32,
    poll_ms: i32
): i32

@[cimport, codename("klin_eth_wait_link")]
fn klin_eth_wait_link(timeout_ms: i32): i32

@[cimport, codename("klin_eth_link_up")]
fn klin_eth_link_up(): i32

@[cimport, codename("klin_eth_wait_ip")]
fn klin_eth_wait_ip(timeout_ms: i32): i32

@[cimport, codename("klin_eth_ip_u32")]
fn klin_eth_ip_u32(): u32

@[cimport, codename("klin_eth_gateway_u32")]
fn klin_eth_gateway_u32(): u32

@[cimport, codename("klin_eth_netmask_u32")]
fn klin_eth_netmask_u32(): u32

@[cimport, codename("klin_eth_log_ip")]
fn klin_eth_log_ip()

@[cimport, codename("klin_eth_log_ip_info")]
fn klin_eth_log_ip_info()

@[cimport, codename("klin_eth_log_mac")]
fn klin_eth_log_mac()

@[cimport, codename("klin_eth_stop")]
fn klin_eth_stop(): i32

/// `ESP_OK` (0).
pub fn err_ok(): i32 {
    return 0
}

/// Typical `SPI2_HOST` on ESP32 / S3 (value `1`).
pub fn spi2_host(): i32 {
    return 1
}

/// Pack `a.b.c.d` into lwIP `u32` order (ESP little-endian host).
pub fn ipv4(a: u32, b: u32, c: u32, d: u32): u32 {
    return a | (b << 8) | (c << 16) | (d << 24)
}

/// Optional static IPv4. Prefer before `w5500_start` (disables DHCP).
/// Pass `0, 0, 0` to clear pending static config (DHCP on next start).
pub fn set_static_ip(ip: u32, gw: u32, netmask: u32): i32 {
    return klin_eth_set_static_ip(ip, gw, netmask)
}

/// Optional netif hostname (DHCP client id / mDNS). Before or after start.
pub fn set_hostname(name: str): i32 {
    return klin_eth_set_hostname(name)
}

/// Install W5500 + netif + start driver. Pins explicit. Returns `esp_err_t` as `i32`.
/// Use `int_gpio = -1` for poll mode (`poll_ms`); `rst_gpio = -1` if unused.
pub fn w5500_start(
    spi_host: i32,
    mosi: i32,
    miso: i32,
    sclk: i32,
    cs: i32,
    int_gpio: i32,
    rst_gpio: i32,
    clock_mhz: i32,
    poll_ms: i32
): i32 {
    return klin_eth_w5500_start(
        spi_host, mosi, miso, sclk, cs, int_gpio, rst_gpio, clock_mhz, poll_ms
    )
}

/// Block until PHY link up (`ETHERNET_EVENT_CONNECTED`) or timeout.
pub fn wait_link(timeout_ms: i32): i32 {
    return klin_eth_wait_link(timeout_ms)
}

/// True after link-up event (cleared on disconnect).
pub fn link_up(): bool {
    return klin_eth_link_up() != 0
}

/// Block until GOT_IP or `timeout_ms` (`-1` = forever).
pub fn wait_ip(timeout_ms: i32): i32 {
    return klin_eth_wait_ip(timeout_ms)
}

pub fn ip_u32(): u32 {
    return klin_eth_ip_u32()
}

pub fn gateway_u32(): u32 {
    return klin_eth_gateway_u32()
}

pub fn netmask_u32(): u32 {
    return klin_eth_netmask_u32()
}

pub fn log_ip() {
    klin_eth_log_ip()
}

/// Debug print of ip / gateway / netmask after `wait_ip`.
pub fn log_ip_info() {
    klin_eth_log_ip_info()
}

/// Debug print of interface MAC (`ETH_CMD_G_MAC_ADDR`).
pub fn log_mac() {
    klin_eth_log_mac()
}

pub fn stop(): i32 {
    return klin_eth_stop()
}
